{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tribusplit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // API y rutas de la app pasan por el Worker; el resto (landing, legales, assets) es estático
    "run_worker_first": ["/api/*", "/app", "/app/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tribusplit-db",
      // reemplazar con el id de `wrangler d1 create tribusplit-db`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // límites por usuario (Workers Rate Limiting, incluido en el plan free)
  "ratelimits": [
    { "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173"
  },
  // limpieza diaria de invitados viejos sin uso (worker/index.ts: cleanupGuests)
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true }
}
